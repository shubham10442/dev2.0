# ==============================================================================
# Ann Food Redistribution Platform - Environment Configuration
# ==============================================================================

# Server Port
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# Real Email Dispatch Configuration (Nodemailer)
# ------------------------------------------------------------------------------
# For Gmail:
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character "App Password":
#    https://myaccount.google.com/apppasswords (Select App: 'Mail', Device: 'Other')
# 3. Paste the credentials below:

EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_FROM="Ann Platform" <noreply@annplatform.org>

# Optional: Custom SMTP Server (SendGrid, Mailgun, Amazon SES, Brevo, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
